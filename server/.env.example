# ---- Server ----
PORT=4000
# Comma-separated list of allowed browser origins (add your deployed frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET. Server only. Never put this in the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Blockchain: LOCAL DEMO (Hardhat node) ----
CHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Hardhat's well-known account #0 key. PUBLIC TEST KEY: worthless, local only.
ISSUER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Filled automatically from contracts/deployments/localhost.json after `npm run deploy:local`
CONTRACT_ADDRESS=
EXPLORER_TX_URL=
EXPLORER_ADDRESS_URL=

# ---- Blockchain: SEPOLIA (uncomment for a public demo) ----
# CHAIN_NETWORK=sepolia
# RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# CHAIN_ID=11155111
# ISSUER_PRIVATE_KEY=0xTHROWAWAY_FAUCET_FUNDED_KEY
# CONTRACT_ADDRESS=0xYourDeployedContract
# EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# EXPLORER_ADDRESS_URL=https://sepolia.etherscan.io/address/
